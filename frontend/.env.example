# Copy to .env (`cp .env.example .env`). src/lib/env.ts is the only reader.

# The FastAPI backend. Inlined into browser JavaScript — never a secret in a NEXT_PUBLIC_ variable.
# Local: the uvicorn dev server. Production: https://api.tamga.qorbee.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# The landing page's film and pictures, a public R2 bucket of their own (never the files' bucket).
# Optional: https://media.qorbee.com when unset.
# NEXT_PUBLIC_MEDIA_URL=https://media.qorbee.com
# Cloudflare Turnstile's site key, before a guest sandbox opens. Unset: no bot check. Cloudflare's
# test key 1x00000000000000000000AA always passes, for trying it on localhost.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
