# The deployment's own variables, read by Compose (deploy/compose.yml), not by the apps: copy to
# deploy/.env on the server. The apps' settings are in backend/.env (backend/.env.example).

# Postgres's superuser password, for the container's own setup: the apps never see it, and
# deploy/tamga's steps (dump, restore, roles) sign in from inside the container. `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# The apps' own role, `tamga`: owner of the database, no superuser (deploy/tamga roles sets it).
# Compose builds DATABASE_URL from it, so it goes nowhere else. Letters and digits only, since it
# sits in that URL unescaped: `openssl rand -hex 24`.
TAMGA_DB_PASSWORD=
# The domain every address comes from: the web app on it and on play., the API on api.
# (deploy/compose.yml). Changing it is this line, the proxy hosts and DNS, then
# `deploy/tamga update`: the web image is built again, since the API's address is in it.
DOMAIN=tamga.qorbee.com
# Cloudflare Turnstile's site key (dashboard → Turnstile), built into the web app; its secret goes
# in backend/.env as TURNSTILE_SECRET_KEY. Empty: no bot check before a guest sandbox opens.
# TURNSTILE_SITE_KEY=
# Nginx Proxy Manager's Docker network: `docker network ls` on the server.
NPM_NETWORK=
# Where `deploy/tamga backup` keeps its dumps on the server (made readable by its owner alone;
# deploy/backups by default, ignored by git), and for how many days.
# BACKUP_DIR=deploy/backups
# BACKUP_DAYS=14
# The public key `deploy/tamga backup --offsite` and `update` encrypt each dump to before it leaves
# the server (deploy/README.md, Backups); its private key stays off the server. Ignored by git.
# BACKUP_KEY=deploy/backup-key.asc
