# The deployment's own variables, read by Compose (deploy/compose.yml), not by the apps: copy to
# deploy/.env on the server. The apps' settings are in backend/.env (backend/.env.example).

# Postgres's password: compose builds DATABASE_URL from it, so it goes nowhere else. Letters and
# digits only, since it sits in that URL unescaped: `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# The API as a browser reaches it, built into the web image.
PUBLIC_API_URL=https://api.tamga.qorbee.com
# Nginx Proxy Manager's Docker network: `docker network ls` on the server.
NPM_NETWORK=
