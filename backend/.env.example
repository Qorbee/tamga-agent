# Copy to .env (`cp .env.example .env`). These values match docker-compose.yml and are LOCAL ONLY.
# Every variable the backend reads is listed here, with a comment; app/config.py is the only reader.

# local | test | staging | production
APP_ENV=local
LOG_LEVEL=INFO

# asyncpg driver URL. Inside docker compose the host is `postgres`, not localhost.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app

# Comma-separated browser origins allowed to call the API with credentials (the session cookie).
# Local: the Next.js dev server. Production: https://tamga.qorbee.com,https://play.tamga.qorbee.com
CORS_ORIGINS=http://localhost:3000

# The web app's address, used in the invite links the backend hands out.
WEB_URL=http://localhost:3000

# Session cookie (ADR-0004). Empty = host-only (local). Production: the parent domain shared by the
# web and API hosts, e.g. .tamga.qorbee.com.
SESSION_COOKIE_DOMAIN=
# How long a signed-in session and an unused invite last, in days.
SESSION_DAYS=30
INVITE_DAYS=7

# Guest sandboxes for judges: lifetime in hours, new guests per client address per hour, and the most
# sandboxes alive at once.
GUEST_HOURS=24
GUEST_SESSIONS_PER_CLIENT_PER_HOUR=5
MAX_ACTIVE_SANDBOXES=200

# Read by uvicorn, not by app/config.py: the proxy addresses whose X-Forwarded-For is trusted. Behind
# Nginx Proxy Manager, set it to the proxy's Docker network, or every guest shares one address and
# one rate limit. Local: unset.
# FORWARDED_ALLOW_IPS=172.18.0.0/16

# Password checks (sign-in, accepting an invite) allowed per client address per hour.
PASSWORD_ATTEMPTS_PER_CLIENT_PER_HOUR=20

# File storage over the S3 API. Local: the SeaweedFS service in docker-compose.yml, which accepts any
# keys; create its bucket once with `curl -X PUT http://localhost:8333/tamga`. Production: the R2
# endpoint (https://<account id>.r2.cloudflarestorage.com), bucket, and an R2 API token's keys.
S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=tamga
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
# R2 takes "auto".
S3_REGION=auto
# The storage endpoint as a browser reaches it, for presigned links, when it differs from
# S3_ENDPOINT_URL (compose's app profile sets it). Usually unset.
# S3_PUBLIC_ENDPOINT_URL=

# The pilot's mailboxes (ADR-0008), read-only over IMAP into the company whose id is here. A JSON list;
# the passwords are the mailboxes' own, so this file never leaves the server. Empty: no mail is read.
# PILOT_COMPANY_ID=00000000-0000-0000-0000-000000000000
# MAILBOXES=[{"host": "imap.example.com", "port": 993, "username": "info@example.com", "password": "..."}]
# The first poll of a folder reads this many days back; each poll takes at most MAIL_BATCH messages
# per folder, so a large backfill spreads over several polls.
MAIL_BACKFILL_DAYS=90
MAIL_BATCH=200
