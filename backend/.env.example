# Copy to .env (`cp .env.example .env`). These values match docker-compose.yml and are LOCAL ONLY.
# Every variable the backend reads is listed here, with a comment; app/config.py is the only reader.

# local | test | staging | production
APP_ENV=local
LOG_LEVEL=INFO

# asyncpg driver URL. Inside docker compose the host is `postgres`, not localhost.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379/0

# Comma-separated browser origins allowed to call the API: the frontend dev server.
# Vite 5173, Next.js 3000, Astro 4321 — keep only the one you use.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4321
