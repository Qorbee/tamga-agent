# Copy to .env (`cp .env.example .env`). These values match docker-compose.yml and are LOCAL ONLY.
# Every variable the backend reads is listed here, with a comment; app/config.py is the only reader.

# local | test | staging | production
APP_ENV=local
LOG_LEVEL=INFO

# asyncpg driver URL. Inside docker compose the host is `postgres`, not localhost.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app

# Comma-separated browser origins allowed to call the API with credentials (the session cookie).
# Local: the Next.js dev server. Production: https://tamga.qorbee.com,https://play.tamga.qorbee.com
CORS_ORIGINS=http://localhost:3000

# The web app's address, used in the invite links the backend hands out.
WEB_URL=http://localhost:3000

# Session cookie (ADR-0004). Empty = host-only (local). Production: the parent domain shared by the
# web and API hosts, e.g. .tamga.qorbee.com.
SESSION_COOKIE_DOMAIN=
# How long a signed-in session and an unused invite last, in days.
SESSION_DAYS=30
INVITE_DAYS=7

# Guest sandboxes for judges: lifetime in hours, new guests per client address per hour, and the most
# sandboxes alive at once.
GUEST_HOURS=24
GUEST_SESSIONS_PER_CLIENT_PER_HOUR=5
MAX_ACTIVE_SANDBOXES=200

# Read by uvicorn, not by app/config.py: the proxy addresses whose X-Forwarded-For is trusted. Behind
# Nginx Proxy Manager, set it to the proxy's Docker network, or every guest shares one address and
# one rate limit. Local: unset.
# FORWARDED_ALLOW_IPS=172.18.0.0/16

# Password checks (sign-in, accepting an invite) allowed per client address per hour.
PASSWORD_ATTEMPTS_PER_CLIENT_PER_HOUR=20

# File storage over the S3 API. Local: the SeaweedFS service in docker-compose.yml, which accepts any
# keys; create its bucket once with `curl -X PUT http://localhost:8333/tamga` (8333, or STORAGE_PORT
# from the root .env). Production: the R2 endpoint (https://<account id>.r2.cloudflarestorage.com),
# the bucket, and an R2 API token's Access Key ID and Secret Access Key; never R2 in a local .env.
S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=tamga
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
# R2 takes "auto".
S3_REGION=auto
# The storage endpoint as a browser reaches it, for presigned links, when it differs from
# S3_ENDPOINT_URL (compose's app profile sets it). Usually unset.
# S3_PUBLIC_ENDPOINT_URL=

# The largest file the upload page accepts, in bytes (25 MB).
UPLOAD_MAX_BYTES=26214400

# The converter that turns Word, RTF and OpenDocument files into PDFs to show and read (ADR-0012):
# Gotenberg, started by `docker compose up -d` on a network with no route out and reached through
# its relay on this port (CONVERTER_PORT in the root .env moves it). Unset: those files stay
# unsupported. Compose's app profile sets its own.
CONVERTER_URL=http://localhost:3100

# The pilot's mailboxes (ADR-0008), read-only over IMAP into the company whose id is here. A JSON list;
# the passwords are the mailboxes' own, so this file never leaves the server. Empty: no mail is read.
# PILOT_COMPANY_ID=00000000-0000-0000-0000-000000000000
# MAILBOXES=[{"host": "imap.example.com", "port": 993, "username": "info@example.com", "password": "..."}]
# The first poll of a folder reads this many days back; each poll takes at most MAIL_BATCH messages
# per folder, so a large backfill spreads over several polls.
MAIL_BACKFILL_DAYS=90
MAIL_BATCH=200

# The pilot's accounting system: read-only, into PILOT_COMPANY_ID (ADR-0008). All three or none: the
# integration's API key, and the admin account's email and password.
# BOOKS_API_KEY=
# BOOKS_EMAIL=
# BOOKS_PASSWORD=
# Unset: the address the country pack knows. Set it only for the product's test environment.
# BOOKS_LOGIN_URL=
# Reads a month Tamga allows itself, under the product's own quota.
BOOKS_MONTHLY_READS=2500
# How far back the first sync of the books reads, in days; later syncs read from where it stopped.
BOOKS_BACKFILL_DAYS=90

# Language models (ADR-0005). A model is provider:name. OpenAI's client is installed; anthropic is
# accepted here but needs its Pydantic AI extra added before an agent can run on it. Every agent
# uses DEFAULT_MODEL unless AGENT_MODELS names another for it, e.g.
# AGENT_MODELS={"linker": "openai:gpt-6-sol-mini"}
DEFAULT_MODEL=openai:gpt-6-sol
# Only a provider some model names needs its key; a deployment without it does not start.
# OpenAI: platform.openai.com, a project key with a monthly budget. Anthropic: console.anthropic.com.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# TypeSafe's Jev, for classification agents only; unset, they run on a language model.
# TYPESAFE_API_KEY=
# Mail conversations a model may read for one company in 24 hours, to sort work from noise. 0:
# code sorts what it can (bulk mail, conversations the company wrote in), the rest waits, and no
# mail's text is sent to the model's provider.
MAIL_MODEL_READS_PER_DAY=0
# Pictures (a photo, a scanned page) the vision model may read for one company in 24 hours: what a
# flood of attachments can cost at most. 0: photos and scans wait unread, and no file is sent to
# the model's provider. Otherwise at least 20, the most pages one file is read for.
VISION_PAGES_PER_DAY=0

# Traces of agent runs, to Langfuse Cloud's EU region (ADR-0007): a project's public and secret key.
# Both or neither; unset, nothing is exported. Pilot companies' message content is never sent.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Circle's developer-controlled wallets on Arc: the console's API key and the registered entity
# secret. Both or neither. Testnet only: a key not starting TEST_API_KEY: is refused.
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# The chain Circle makes wallets on. Testnet only until mainnet is an explicit, reviewed opt-in.
CIRCLE_BLOCKCHAIN=ARC-TESTNET
# Printed by `uv run python scripts/create_circle_wallets.py`, which creates them once.
# CIRCLE_WALLET_SET_ID=
# CIRCLE_TREASURY_WALLET_ID=
# The chain's own constants, here Arc testnet's: USDC's ERC-20 interface (6 decimals), and the
# explorer a transaction or an address is shown on.
USDC_ADDRESS=0x3600000000000000000000000000000000000000
ARC_EXPLORER_URL=https://testnet.arcscan.app
# Printed by `uv run python scripts/deploy_policy_vault.py`, which deploys the vault once from the
# treasury wallet. Unset: nothing can be paid. Tamga's own on Arc testnet is
# 0x6354dbccc4f5063fd10b9b1e4ff66d65d4224d0a; a vault of your own has your treasury as its admin.
# POLICY_VAULT_ADDRESS=
