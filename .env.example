# Host ports for docker compose, read from .env at the repository root (git-ignored). The defaults
# suit most machines; change one only when another project already holds it, and name the same port
# where the apps connect from outside compose: DATABASE_URL and S3_ENDPOINT_URL in backend/.env, the
# API URL in frontend/.env. A deployment publishes none of these (docs/architecture/01).
POSTGRES_PORT=5432
STORAGE_PORT=8333
BACKEND_PORT=8000
WEB_PORT=3000
